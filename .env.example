# S3 Compatible Storage Connection
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# S3 Public CDN URL (Contoh: https://cdn.domain.com atau https://pub-xxx.r2.dev atau https://bucket.s3.region.amazonaws.com)
# Gambar akan disajikan langsung lewat URL CDN publik ini sehingga menghemat bandwidth Netlify
S3_PUBLIC_CDN_URL=""

# Opsional: JWT Secret (jika tidak diisi, otomatis dibuat & disimpan di database)
JWT_SECRET=""
